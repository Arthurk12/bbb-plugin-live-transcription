{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist/",
        "noImplicitAny": true,
        "module": "es6",
        "target": "es2020",
        "skipLibCheck": true,
        "jsx": "react",
        "allowJs": true,
        "moduleResolution": "bundler",
        "types": [
          "node",
        ],
    },
    "include": ["src/*"],
    "paths": {
        "*": ["node_modules"]
    },
    "exclude": [
        "node_modules"
    ]
}
